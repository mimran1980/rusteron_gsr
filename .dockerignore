# Build-context hygiene for the rusteron images.
#   * Dockerfile (valgrind)      — COPYs only id_ed25519.pub (repo mounts at runtime)
#   * deploy/aws-eks/Dockerfile.media-driver — COPYs the whole workspace (build-from-source)
# Neither needs VCS history, build outputs, or secrets; the valgrind image needs
# the .pub key (kept below), never the private id_ed25519.

# VCS
.git
**/.git

# Rust build outputs
target
**/target
**/aeron/build

# Secrets (keep id_ed25519.pub: it is the valgrind image's authorized_keys)
id_ed25519
*.key
*.pem

# Local cluster scratch (never committed; media driver leaves these behind)
aeron-cluster-0
aeron-cluster-1
aeron-cluster-2

# OS / editor / stray
.DS_Store
package-lock.json
