# Amazon Linux 2023 runtime image for the rusteron-media-driver DPDK ENA
# kernel-bypass transport (plan §9/§10). Built on AL2023 x86_64 so the image
# records the exact distro/DPDK/ENA versions; uses `--features static,dpdk` so
# both the Aeron driver C and the DPDK native transport are compiled from the
# workspace. The node's secondary ENAs are bound to vfio-pci by
# node/bootstrap-dpdk-ena.sh on the host, never inside this container.
#
# AL2023 ships no DPDK packages, so the builder compiles DPDK 23.11 from source
# (pinned tarball, ENA PMD only) and installs it to /usr/local; the runtime
# image carries the shared librte_* libs. `enable_drivers=net/ena` builds just
# the ENA PMD plus the mandatory bus/pci, bus/vdev, mempool/ring.
#
# Build (from the repo root):
#   docker build -f deploy/aws-eks/Dockerfile.media-driver -t rusteron-media-driver:dpdk .
# Verify:
#   docker run --rm rusteron-media-driver:dpdk ldd /usr/local/bin/media_driver
FROM --platform=linux/amd64 public.ecr.aws/amazonlinux/amazonlinux:2023 AS builder

# Build deps. cmake + pyelftools come via pip (no AL2023 packages).
RUN dnf install -y \
        gcc gcc-c++ make clang \
        pkgconf-pkg-config \
        libbsd-devel libuuid-devel openssl-devel zlib-devel \
        numactl-devel \
        meson ninja-build tar xz \
        python3-pip \
    && dnf clean all \
    # AL2023 ships pip 21.3.1 (no --break-system-packages; no PEP 668 check).
    && python3 -m pip install --no-cache-dir cmake pyelftools

# DPDK 23.11 from source (EN-only, shared libs to /usr/local/lib64).
RUN curl -fsSLO https://fast.dpdk.org/rel/dpdk-23.11.tar.xz \
    && tar -xJf dpdk-23.11.tar.xz \
    && cd dpdk-23.11 \
    # `examples` defaults to empty (no examples); -Dexamples=disabled would
    # look for an example literally named "disabled" and fail.
    && meson setup build -Denable_drivers=net/ena -Dtests=false \
    && ninja -C build \
    && meson install -C build

# Rust toolchain pinned to the workspace version (rust-toolchain.toml).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain 1.95.0 --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"
# libdpdk.pc lands in the meson-install pkgconfig dir.
ENV PKG_CONFIG_PATH="/usr/local/lib64/pkgconfig"

WORKDIR /src
COPY . .

# The DPDK ENA transport requires Linux x86_64; this image is amd64-only.
# `static` implies `build-from-source`; the libdpdk pkg-config probe resolves
# against the source-built DPDK (23.11).
RUN cargo build -p rusteron-media-driver --release --features static,dpdk

# Record the exact DPDK/ENA versions the image was built against (plan §9:
# "Build on AL2023 and record exact DPDK/ENA versions").
RUN { \
        echo "distro: Amazon Linux 2023 ($(cat /etc/system-release))"; \
        echo "kernel: $(uname -r)"; \
        echo "dpdk: $(pkg-config --modversion libdpdk 2>/dev/null || echo unknown) (source-built dpdk-23.11.tar.xz)"; \
        echo "ena-driver: $(modinfo -F version ena 2>/dev/null || echo not-loaded-in-container)"; \
        echo "aeron-git: $(git -C /src/rusteron-media-driver/aeron rev-parse --short HEAD 2>/dev/null || echo unknown)"; \
    } > /etc/rusteron-dpdk-versions.txt

# ---- runtime ----
FROM --platform=linux/amd64 public.ecr.aws/amazonlinux/amazonlinux:2023

# Runtime libs for the statically-linked media_driver: libnuma (DPDK EAL) and
# libbsd/libuuid (Aeron driver); the librte_* shared libs come from the builder.
RUN dnf install -y numactl-libs libbsd libuuid \
    && dnf clean all

COPY --from=builder /usr/local/lib64 /usr/local/lib64
# Loader finds the DPDK shared libs (media_driver links librte_*).
RUN echo "/usr/local/lib64" > /etc/ld.so.conf.d/rusteron-dpdk.conf && ldconfig

COPY --from=builder /src/target/release/media_driver /usr/local/bin/media_driver
COPY --from=builder /etc/rusteron-dpdk-versions.txt /etc/rusteron-dpdk-versions.txt
COPY deploy/aws-eks/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/media_driver /usr/local/bin/entrypoint.sh

# Hugepages and the vfio-pci bound ENAs live on the node (host), mounted into
# the pod by the kubelet; the container itself only needs /dev/hugepages for
# the DPDK EAL mempools. CMD is overridable (e.g. `docker run ... ldd ...`).
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/media_driver"]
